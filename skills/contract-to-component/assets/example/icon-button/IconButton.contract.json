{
  "$schema": "./component.schema.json",
  "id": "icon-button",
  "name": "IconButton",
  "version": "0.1.0",
  "status": "draft",
  "category": "action",
  "description": "Square button that shows only an icon and triggers an action. Same variants, colors and sizes as Button, but with no label: the accessible name goes in `aria-label`, which is required.",
  "guidance": {
    "dos": [
      "Always provide `aria-label` with the action (\"Clear search\", \"Close dialog\").",
      "Use icons from the registry (`icons/registry.json`) and make sure their meaning is universal: X, Trash2, Plus, Search.",
      "Inside a field (TextField) use `variant=\"ghost\"` and `color=\"neutral\"`.",
      "For non-obvious actions, add a Tooltip: an icon alone is not always understood.",
      "To make two IconButtons look like a toolbar, use the same `variant` and `size` on all of them."
    ],
    "donts": [
      {
        "case": "Action with visible text",
        "useInstead": "Button (with `icon` if needed)",
        "why": "With text the button is understood without a tooltip and is easier to press."
      },
      {
        "case": "IconButton without aria-label",
        "useInstead": "Always aria-label",
        "why": "Without an accessible name the screen reader only says \"button\"."
      },
      {
        "case": "Decorative icon that does nothing",
        "useInstead": "Icon",
        "why": "A button with no action misleads people navigating by keyboard."
      },
      {
        "case": "State that persists (on / off)",
        "useInstead": "Toggle or Checkbox",
        "why": "A button runs an action; it does not hold state."
      },
      {
        "case": "Destructive action without confirmation",
        "useInstead": "color='error' + AlertDialog",
        "why": "A small icon is more easily pressed by mistake."
      }
    ],
    "related": [
      {
        "component": "Button",
        "relation": "alternative",
        "difference": "Has a text label; IconButton is icon only."
      },
      {
        "component": "Icon",
        "relation": "contains",
        "difference": "Receives the icon in the `icon` slot; the button's size sets the icon size."
      },
      {
        "component": "TextField",
        "relation": "contained-by",
        "difference": "Used as the field's trailing button (clear, show password)."
      }
    ]
  },
  "semantics": {
    "element": "button",
    "role": null,
    "refTarget": "root",
    "elementByProp": null
  },
  "props": [
    {
      "name": "variant",
      "type": "'classic' | 'solid' | 'soft' | 'surface' | 'outline' | 'ghost'",
      "default": "solid",
      "description": "Visual emphasis. solid = full fill; classic = fill with gradient and border; soft = subtle fill; surface = border with soft background; outline = border only; ghost = no fill or border until hover.",
      "bindings": {
        "figma": {
          "property": "variant",
          "type": "VARIANT"
        }
      }
    },
    {
      "name": "color",
      "type": "'accent' | 'neutral' | 'error'",
      "default": "accent",
      "description": "Color meaning. accent = brand color; neutral = gray; error = destructive action.",
      "bindings": {
        "figma": {
          "property": "color",
          "type": "VARIANT"
        }
      }
    },
    {
      "name": "size",
      "type": "'1' | '2' | '3' | '4'",
      "default": "2",
      "description": "Physical size of the square: 24 / 32 / 40 / 48 px, with a 16 / 16 / 18 / 20 px icon and a radius per size. 2 is the default. Same size as Button: an IconButton size 2 has the same height as a Button size 2.",
      "bindings": {
        "figma": {
          "property": "size",
          "type": "VARIANT"
        }
      }
    },
    {
      "name": "highContrast",
      "type": "boolean",
      "default": false,
      "description": "If true, increases contrast: uses step 12 of the scale instead of 9/11.",
      "bindings": {
        "figma": {
          "property": "highContrast",
          "type": "VARIANT",
          "value": "true"
        }
      }
    },
    {
      "name": "loading",
      "type": "boolean",
      "default": false,
      "description": "If true, the action is in progress: a spinner replaces the icon, the size does not change and it cannot be pressed.",
      "bindings": {
        "figma": {
          "property": "loading",
          "type": "VARIANT",
          "value": "true"
        }
      }
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": false,
      "description": "If true, the button is not interactive. In Figma it is the \"disable\" value of the `state` axis.",
      "bindings": {
        "figma": {
          "property": "state",
          "type": "VARIANT",
          "value": "disable"
        }
      }
    },
    {
      "name": "icon",
      "type": "ReactNode",
      "required": true,
      "description": "The icon. The only visible content of the button. Size by size: 16 / 16 / 18 / 20 px. Decorative: it is named by the button's aria-label, not by the icon.",
      "usage": "icon={<Plus />}",
      "bindings": {
        "figma": {
          "property": "⮑ 🔄 icon",
          "type": "INSTANCE_SWAP"
        }
      }
    },
    {
      "name": "aria-label",
      "type": "string",
      "required": true,
      "description": "Accessible name. Required: the button has no visible text. Describe the action (\"Clear\", \"Close\"), not the icon (\"X\").",
      "usage": "aria-label=\"Cerrar\"",
      "bindings": {
        "figma": null
      }
    },
    {
      "name": "type",
      "type": "'button' | 'submit' | 'reset'",
      "default": "button",
      "description": "Native button type. Code only. Use 'submit' explicitly to submit forms.",
      "bindings": {
        "figma": null
      }
    },
    {
      "name": "onPress",
      "type": "(event: MouseEvent<HTMLButtonElement>) => void",
      "default": null,
      "description": "Press handler (mouse, keyboard or touch). Code only.",
      "bindings": {
        "figma": null
      }
    }
  ],
  "states": {
    "native": [
      "hover",
      "focus-visible",
      "active"
    ],
    "controlled": [
      {
        "name": "loading",
        "description": "The triggered action is in progress. Not interactive; shows a spinner instead of the icon.",
        "aria": "aria-busy='true'"
      },
      {
        "name": "disabled",
        "description": "Not interactive. The option exists but is not available right now. Painted with neutral tokens (neutral-alpha), never with opacity.",
        "aria": "disabled (native HTML attribute)"
      }
    ]
  },
  "anatomy": {
    "root": {
      "element": "button",
      "description": "Root interactive element. Always a native <button>, square.",
      "figmaLayer": "Icon Button (each variant of the component set)"
    },
    "focusRing": {
      "element": "css",
      "description": "Not an element: painted with :focus-visible. In Figma it is a layer shown with the focusRing boolean: 4px outer border and 2px inner border.",
      "optional": true,
      "figmaLayer": "focus-ring",
      "figmaToggle": {
        "property": "focusRing",
        "type": "BOOLEAN",
        "default": false
      }
    },
    "icon": {
      "element": "slot",
      "description": "Icon slot. Always present except when loading.",
      "optional": false,
      "figmaLayer": "content-container › Design / blending-mode",
      "slot": {
        "key": "icon",
        "allowedComponents": [
          "Icon"
        ],
        "minItems": 1,
        "maxItems": 1,
        "mandatory": true,
        "figmaProp": "⮑ 🔄 icon"
      }
    },
    "spinner": {
      "element": "svg",
      "description": "Spinner. Only with loading=true; replaces the icon.",
      "optional": true,
      "figmaLayer": "content-container › Spinner (16px at size 2)"
    }
  },
  "composition": {
    "allowedChildren": null,
    "forbiddenChildren": [
      "Button",
      "IconButton",
      "a",
      "input"
    ],
    "nestedComponents": [
      {
        "part": "icon",
        "component": "Icon"
      }
    ],
    "asChild": false
  },
  "layout": {
    "height": {
      "mode": "fixed",
      "values": {
        "1": 24,
        "2": 32,
        "3": 40,
        "4": 48
      },
      "unit": "px",
      "token": "tokens.space.button-height-{size}",
      "note": "In Figma the IconButton does not bind the height to any variable (loose 24/32/40/48); it matches Button's height tokens."
    },
    "width": {
      "default": "fixed",
      "modes": {
        "fixed": "Equal to the height: always square. No hug or fill."
      },
      "min": null,
      "max": null,
      "note": "Width = height (24 / 32 / 40 / 48). If you need a larger touch area, add it with padding on the container; do not change the size."
    },
    "autoLayout": {
      "direction": "HORIZONTAL",
      "sizingHorizontal": "FIXED",
      "sizingVertical": "FIXED",
      "alignMain": "CENTER",
      "alignCross": "CENTER",
      "gap": "Not applicable (single child)"
    },
    "iconSize": {
      "values": {
        "1": 16,
        "2": 16,
        "3": 18,
        "4": 20
      },
      "unit": "px"
    }
  },
  "tokens": {
    "policy": {
      "allowed": [
        "colors",
        "tokens.colors",
        "tokens.space",
        "radius",
        "shadows"
      ],
      "forbidden": []
