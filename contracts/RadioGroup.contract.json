{
  "$schema": "./component.schema.json",
  "id": "radio-group",
  "name": "RadioGroup",
  "version": "0.1.0",
  "status": "draft",
  "category": "input",
  "description": "Set of mutually exclusive options: only one can be selected at a time. Each option is a Radio with its label.",
  "guidance": {
    "dos": [
      "Use 2 to 6 options visible at a time and show all options at a glance.",
      "Give the group an accessible name (aria-label or aria-labelledby): Figma does not define a group label.",
      "Short, parallel labels, phrased positively.",
      "Preselect the safest or most common option when it makes sense.",
      "Keep the options in a single column; the order reflects priority or natural logic."
    ],
    "donts": [
      {
        "case": "Several options at once",
        "useInstead": "Checkbox / CheckboxGroup",
        "why": "A radio allows only one selection."
      },
      {
        "case": "More than 6 options or a long list",
        "useInstead": "Select",
        "why": "Takes up too much space and makes comparison harder."
      },
      {
        "case": "Turning a setting on instantly",
        "useInstead": "Switch",
        "why": "A radio group is confirmed with the form."
      },
      {
        "case": "Group with no available option or with only one",
        "useInstead": "Checkbox or text",
        "why": "A single option is not a choice."
      }
    ],
    "related": [
      {
        "component": "Checkbox",
        "relation": "alternative",
        "difference": "Allows multiple selections and an indeterminate state."
      },
      {
        "component": "Select",
        "relation": "alternative",
        "difference": "Better with many options."
      },
      {
        "component": "Switch",
        "relation": "alternative",
        "difference": "Immediate effect."
      }
    ]
  },
  "semantics": {
    "element": "div",
    "role": "radiogroup",
    "refTarget": "root",
    "elementByProp": null
  },
  "props": [
    {
      "name": "variant",
      "type": "'classic' | 'surface' | 'soft'",
      "default": "surface",
      "description": "Appearance of all radios. surface = light background with border; classic = same with shadow; soft = subtle accent fill with no border.",
      "bindings": {
        "figma": {
          "property": "variant",
          "type": "VARIANT"
        }
      }
    },
    {
      "name": "size",
      "type": "'1' | '2' | '3'",
      "default": "2",
      "description": "Radio size: 14 / 16 / 20 px, with its text and the space between options. 2 is the default.",
      "bindings": {
        "figma": {
          "property": "size",
          "type": "VARIANT"
        }
      }
    },
    {
      "name": "highContrast",
      "type": "boolean",
      "default": false,
      "description": "If true, the selected option uses step 12 of the accent. Unselected does not change.",
      "bindings": {
        "figma": {
          "property": "highContrast",
          "type": "VARIANT",
          "value": "true"
        }
      }
    },
    {
      "name": "children",
      "type": "ReactNode (RadioGroup.Item)",
      "required": true,
      "description": "The options. In Figma, up to 6 with the booleans item #1…#6; 3 are shown by default.",
      "bindings": {
        "figma": {
          "property": "item #1…#6",
          "type": "BOOLEAN"
        }
      }
    },
    {
      "name": "value",
      "type": "string | undefined",
      "default": null,
      "description": "Value of the selected option. In Figma, the selection is the `status=checked` axis of a specific Radio (instance override), not a group property.",
      "bindings": {
        "figma": null
      }
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": false,
      "description": "If true, disables the whole group. In Figma it only exists per option (`state=disable` of the Radio); the group does not have it.",
      "bindings": {
        "figma": null
      }
    },
    {
      "name": "name",
      "type": "string | undefined",
      "default": null,
      "description": "Field name when submitting a form. Code only.",
      "bindings": {
        "figma": null
      }
    },
    {
      "name": "onValueChange",
      "type": "(value: string) => void",
      "default": null,
      "description": "Emitted when the selection changes. Code only.",
      "bindings": {
        "figma": null
      }
    }
  ],
  "states": {
    "native": [
      "hover",
      "focus-visible",
      "active"
    ],
    "controlled": [
      {
        "name": "checked",
        "description": "The selected option. Shows the indicator (dot).",
        "aria": "aria-checked='true' on the item; the rest false"
      },
      {
        "name": "disabled",
        "description": "Not interactive. Background and border with neutral tokens; never with opacity.",
        "aria": "disabled on the item (or on all of them)"
      }
    ]
  },
  "anatomy": {
    "root": {
      "element": "div",
      "description": "Vertical container of the options. Has role=radiogroup.",
      "figmaLayer": "item-container"
    },
    "item": {
      "element": "slot",
      "description": "Slot for each option (RadioGroup.Item).",
      "figmaLayer": "Radio",
      "slot": {
        "key": "item",
        "allowedComponents": [
          "RadioGroup.Item"
        ],
        "minItems": 2,
        "maxItems": 6,
        "mandatory": true,
        "figmaProp": "item #1…#6"
      }
    },
    "focusRing": {
      "element": "css",
      "description": "Not an element: painted with :focus-visible on the radio. In Figma it is the focusRing boolean of each Radio: 4px outer border and 2px inner border.",
      "optional": true,
      "figmaLayer": "focus-ring",
      "figmaToggle": {
        "property": "focusRing",
        "type": "BOOLEAN",
        "default": false
      }
    },
    "radio": {
      "element": "button",
      "description": "The circle of each option. Has role=radio and aria-checked.",
      "figmaLayer": "radio"
    },
    "indicator": {
      "element": "span",
      "description": "Center dot of the selected option. Hidden if not selected.",
      "optional": true,
      "figmaLayer": "indicator"
    },
    "itemLabel": {
      "element": "label",
      "description": "Text of each option. Associated with the radio.",
      "optional": true,
      "figmaLayer": "Text",
      "figmaToggle": {
        "property": "text",
        "type": "BOOLEAN",
        "default": false
      }
    }
  },
  "composition": {
    "allowedChildren": [
      "RadioGroup.Item"
    ],
    "forbiddenChildren": [
      "RadioGroup",
      "Button"
    ],
    "nestedComponents": [],
    "codeParts": [
      {
        "name": "RadioGroup.Root",
        "description": "The group (this component)."
      },
      {
        "name": "RadioGroup.Item",
        "description": "One option: props value (string, required), disabled and label (children)."
      }
    ],
    "asChild": false,
    "item": {
      "figmaComponent": "Radio (851:29635), 144 variants, Figma's own component",
      "props": [
        {
          "name": "value",
          "type": "string",
          "required": true,
          "figma": null
        },
        {
          "name": "label",
          "type": "string | undefined",
          "figma": {
            "property": "⮑ ✏️ text",
            "type": "TEXT",
            "toggle": "text"
          }
        },
        {
          "name": "disabled",
          "type": "boolean",
          "figma": {
            "property": "state",
            "type": "VARIANT",
            "value": "disable"
          }
        },
        {
          "name": "checked (derived from value)",
          "type": "boolean",
          "figma": {
            "property": "status",
            "type": "VARIANT",
            "value": "checked ✓"
          }
        }
      ]
    }
  },
  "layout": {
    "height": {
      "mode": "hug",
      "values": {
        "1": 56,
        "2": 76,
        "3": 96
      },
      "unit": "px",
      "token": null,
      "note": "Example height with 3 visible options. Grows with each option."
    },
    "width": {
      "default": "hug",
      "modes": {
        "hug": "The widest option.",
        "fill": "Decided by whoever uses the component.",
        "fixed": "In Figma, 160px as an example."
      },
      "min": null,
      "max": null,
      "note": "No width tokens."
    },
    "autoLayout": {
      "direction": "VERTICAL",
      "sizingHorizontal": "HUG",
      "sizingVertical": "HUG",
      "alignMain": "MIN",
      "alignCross": "MIN",
      "gap": "Between options, by size: spacing.1 / 2 / 3. Inside each option, between radio and text: spacing.2 / 2 / 3."
    },
    "radioSize": {
      "values": {
        "1": 14,
