{
  "$schema": "./component.schema.json",
  "id": "checkbox",
  "name": "Checkbox",
  "version": "0.1.0",
  "status": "draft",
  "category": "input",
  "description": "Box that turns an independent option on or off, with a third \"indeterminate\" state for partial selections. Used in forms and lists.",
  "guidance": {
    "dos": [
      "Use a visible label (`label`) that describes the option in positive terms: \"Receive news\".",
      "Use `indeterminate` only for a \"select all\" when some children are checked and others are not.",
      "Group related checkboxes in CheckboxGroup.",
      "The box and its label are a single pressable target: pressing the label checks the box."
    ],
    "donts": [
      {
        "case": "Choosing a single option among several",
        "useInstead": "RadioGroup",
        "why": "A checkbox lets you check several at once."
      },
      {
        "case": "Turning on something that takes effect instantly (a setting)",
        "useInstead": "Switch",
        "why": "A checkbox is confirmed when the form is submitted; a Switch acts on change."
      },
      {
        "case": "Triggering an action",
        "useInstead": "Button",
        "why": "A checkbox stores a value; it does not execute."
      },
      {
        "case": "Checkbox without a label",
        "useInstead": "Checkbox with label or aria-label",
        "why": "Without an accessible name it is unclear what is being checked."
      }
    ],
    "related": [
      {
        "component": "CheckboxGroup",
        "relation": "contained-by",
        "difference": "Groups 1 to 6 checkboxes vertically with a gap of spacing.3."
      },
      {
        "component": "RadioGroup",
        "relation": "alternative",
        "difference": "Only one option."
      },
      {
        "component": "Switch",
        "relation": "alternative",
        "difference": "Immediate effect."
      }
    ]
  },
  "semantics": {
    "element": "button",
    "role": "checkbox",
    "refTarget": "box",
    "elementByProp": null
  },
  "props": [
    {
      "name": "variant",
      "type": "'classic' | 'surface' | 'soft'",
      "default": "surface",
      "description": "Appearance. surface = light background with border; classic = same with shadow; soft = subtle accent fill with no border.",
      "bindings": {
        "figma": {
          "property": "variant",
          "type": "VARIANT"
        }
      }
    },
    {
      "name": "size",
      "type": "'1' | '2' | '3'",
      "default": "2",
      "description": "Checkbox size: 14 / 16 / 20 px, with its text and spacing. 2 is the default.",
      "bindings": {
        "figma": {
          "property": "size",
          "type": "VARIANT"
        }
      }
    },
    {
      "name": "highContrast",
      "type": "boolean",
      "default": false,
      "description": "If true and the checkbox is checked, uses step 12 of the accent. Unchecked it does not change.",
      "bindings": {
        "figma": {
          "property": "highContrast",
          "type": "VARIANT",
          "value": "true"
        }
      }
    },
    {
      "name": "checked",
      "type": "boolean | 'indeterminate'",
      "default": false,
      "description": "Value. In Figma it is the `status` axis: false = \"unchecked ✦\", true = \"checked ✓\", 'indeterminate' = \"indeterminate\".",
      "bindings": {
        "figma": {
          "property": "status",
          "type": "VARIANT"
        }
      }
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": false,
      "description": "If true, it cannot be checked or focused. In Figma it is the \"disable\" value of the `state` axis.",
      "bindings": {
        "figma": {
          "property": "state",
          "type": "VARIANT",
          "value": "disable"
        }
      }
    },
    {
      "name": "label",
      "type": "string | undefined",
      "default": null,
      "description": "Text next to the checkbox. In Figma the `text` boolean shows or hides it (hidden by default). Sample text: \"Text\".",
      "bindings": {
        "figma": {
          "property": "⮑ ✏️ text",
          "type": "TEXT"
        }
      }
    },
    {
      "name": "name",
      "type": "string | undefined",
      "default": null,
      "description": "Field name when submitting a form. Code only.",
      "bindings": {
        "figma": null
      }
    },
    {
      "name": "onCheckedChange",
      "type": "(checked: boolean | 'indeterminate') => void",
      "default": null,
      "description": "Emitted when the value changes. Code only.",
      "bindings": {
        "figma": null
      }
    }
  ],
  "states": {
    "native": [
      "hover",
      "focus-visible",
      "active"
    ],
    "controlled": [
      {
        "name": "checked",
        "description": "Checkbox checked. Shows the check.",
        "aria": "aria-checked='true'"
      },
      {
        "name": "indeterminate",
        "description": "Partial selection. Shows a dash.",
        "aria": "aria-checked='mixed'"
      },
      {
        "name": "disabled",
        "description": "Not interactive. Background and border with neutral tokens; never with opacity.",
        "aria": "disabled (native HTML attribute)"
      }
    ]
  },
  "anatomy": {
    "root": {
      "element": "span",
      "description": "Container for box and label. A single pressable target.",
      "figmaLayer": "Checkbox (each variant of the component set)"
    },
    "focusRing": {
      "element": "css",
      "description": "Not an element: painted with :focus-visible. In Figma it is a layer shown with the focusRing boolean: 4px outer border and 2px inner.",
      "optional": true,
      "figmaLayer": "focus-ring",
      "figmaToggle": {
        "property": "focusRing",
        "type": "BOOLEAN",
        "default": false
      }
    },
    "box": {
      "element": "button",
      "description": "The box. Carries role=checkbox and aria-checked.",
      "figmaLayer": "checkbox"
    },
    "indicator": {
      "element": "svg",
      "description": "Check (checked) or dash (indeterminate). Hidden when unchecked.",
      "optional": true,
      "figmaLayer": "Abstract / check | Typography / dash"
    },
    "label": {
      "element": "label",
      "description": "Text next to the box. Associated with the box.",
      "optional": true,
      "figmaLayer": "Text",
      "figmaToggle": {
        "property": "text",
        "type": "BOOLEAN",
        "default": false
      },
      "content": {
        "prop": "label"
      }
    }
  },
  "composition": {
