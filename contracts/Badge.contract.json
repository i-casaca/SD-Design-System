{
    "$schema": "./component.schema.json",
    "id": "badge",
    "name": "Badge",
    "version": "0.1.0",
    "status": "draft",
    "category": "feedback",
    "description": "Small, non-interactive label that summarizes a status, a category or a short value. It can carry an icon at the start.",
    "guidance": {
        "dos": [
            "Short text, one or two words: \"New\", \"In review\". If you need a sentence, it is not a Badge.",
            "The text must state the status on its own: color reinforces it but cannot be the only signal (WCAG 1.4.1).",
            "Use `color=\"neutral\"` for neutral information and `success`, `warning`, `error` or `info` when the color carries status meaning.",
            "Use `variant=\"solid\"` for what must stand out and `soft` (the default) for the rest. `outline` and `surface` are for already busy backgrounds.",
            "Use `highContrast` when the accent color does not give enough contrast on the background."
        ],
        "donts": [
            {
                "case": "Something that can be pressed (filter, action, close)",
                "useInstead": "Button",
                "why": "A Badge is not interactive: it receives no focus, no keyboard input and has no hover state. If it looks like a button, people will try to press it."
            },
            {
                "case": "Navigate to another page or resource",
                "useInstead": "Link",
                "why": "A link can be opened, copied, and screen readers announce it as a link."
            },
            {
                "case": "Long messages or several sentences",
                "useInstead": "Regular text or a warning",
                "why": "The Badge does not truncate or wrap text: the width fits its content and it overflows."
            },
            {
                "case": "Color as the only way to know the status",
                "useInstead": "Text that states the status, plus color",
                "why": "People with color blindness or screen readers do not receive the color."
            }
        ],
        "related": [
            {
                "component": "Button",
                "relation": "similar",
                "difference": "Performs an action; the Badge only informs."
            },
            {
                "component": "Link",
                "relation": "similar",
                "difference": "Navigates; the Badge only informs."
            },
            {
                "component": "Icon",
                "relation": "contains",
                "difference": "The Badge's leading icon is an Icon."
            }
        ]
    },
    "semantics": {
        "element": "span",
        "role": null,
        "refTarget": "root",
        "elementByProp": null
    },
    "props": [
        {
            "name": "variant",
            "type": "'solid' | 'soft' | 'outline' | 'surface'",
            "default": "soft",
            "description": "Visual emphasis. solid = full fill; soft = subtle fill; outline = border only; surface = border with soft background. In Figma the value marked ✦ is soft.",
            "bindings": {
                "figma": {
                    "property": "variant",
                    "type": "VARIANT"
                }
            }
        },
        {
            "name": "color",
            "type": "'accent' | 'neutral' | 'error' | 'success' | 'warning' | 'info' | 'tomato' | 'red' | 'ruby' | 'crimson' | 'pink' | 'plum' | 'purple' | 'violet' | 'iris' | 'indigo' | 'blue' | 'cyan' | 'teal' | 'jade' | 'green' | 'grass' | 'orange' | 'brown' | 'sky' | 'mint' | 'lime' | 'yellow' | 'amber' | 'bronze' | 'gold'",
            "default": "accent",
            "description": "Badge color. accent and neutral use the theme scales; error, success, warning and info are the semantic colors; the rest are Radix color scales. It is the only component in the system with more than three colors.",
            "bindings": {
                "figma": {
                    "property": "color",
                    "type": "VARIANT"
                }
            }
        },
        {
            "name": "size",
            "type": "'1' | '2' | '3'",
            "default": "1",
            "description": "Size: height of 20 / 24 / 28 px, with its padding, gap, radius and text style. In Figma the value marked ✦ is 1.",
            "bindings": {
                "figma": {
                    "property": "size",
                    "type": "VARIANT"
                }
            }
        },
        {
            "name": "highContrast",
            "type": "boolean",
            "default": false,
            "description": "If true, strengthens contrast: uses step 12 of the scale for text, background or border depending on the variant. In Figma the axis is called \"highConstrast\" (typo in the file).",
            "bindings": {
                "figma": {
                    "property": "highConstrast",
                    "type": "VARIANT",
                    "value": "true"
                }
            }
        },
        {
            "name": "icon",
            "type": "ReactNode | undefined",
            "default": null,
            "description": "Leading icon. If not passed, nothing is rendered. Only a leading icon exists; there is no trailing icon.",
            "usage": "icon={<Check />}",
            "bindings": {
                "figma": {
                    "property": "⮑ 🔄 iconStart",
                    "type": "INSTANCE_SWAP"
                }
            }
        },
        {
            "name": "children",
            "type": "ReactNode",
            "required": true,
            "description": "Badge text. Default text in Figma: \"Badge\".",
            "bindings": {
                "figma": {
                    "property": "✏️ text",
                    "type": "TEXT"
                }
            }
        }
    ],
    "states": {
        "native": [],
        "controlled": []
    },
    "anatomy": {
        "root": {
            "element": "span",
            "description": "Root element. An inline <span> with horizontal auto layout; not interactive.",
            "figmaLayer": "Badge (each variant of the component set)"
        },
        "icon": {
            "element": "slot",
            "description": "Slot for the leading icon. Hidden when there is no icon.",
            "optional": true,
            "figmaLayer": "Design / inner-shadow (instancia)",
            "figmaToggle": {
                "property": "iconStart",
                "type": "BOOLEAN",
                "default": false
            },
            "slot": {
                "key": "icon",
                "allowedComponents": [
                    "Icon"
                ],
                "minItems": 0,
                "maxItems": 1,
                "mandatory": false,
                "figmaProp": "⮑ 🔄 iconStart"
            }
        },
        "label": {
            "element": "span",
            "description": "Badge text.",
            "figmaLayer": "Badge (capa de texto)",
            "content": {
                "prop": "children"
            }
        }
    },
    "composition": {
        "allowedChildren": null,
        "forbiddenChildren": [
            "Button",
            "IconButton",
            "Link",
            "a",
            "button",
            "input"
        ],
        "nestedComponents": [],
        "asChild": false
    },
    "layout": {
        "height": {
            "mode": "hug",
            "values": {
                "1": 20,
                "2": 24,
                "3": 28
            },
            "unit": "px",
            "token": null,
            "note": "Height = vertical padding + text line height (2+16+2, 4+16+4 and 4+20+4). There is no height token: it results from the layout."
        },
        "width": {
            "default": "hug",
            "modes": {
                "hug": "Fits the text plus horizontal padding and the icon if present. Always; there is no fill or fixed."
            },
            "min": null,
            "max": null,
            "note": "In Figma, with the sample text \"Badge\": 49 / 53 / 63 px with no visible icon."
        },
        "autoLayout": {
            "direction": "HORIZONTAL",
            "sizingHorizontal": "HUG",
            "sizingVertical": "HUG",
            "alignMain": "CENTER",
            "alignCross": "CENTER",
            "gap": "Per size: 6 / 6 / 8 px, between icon and text. Only size 3 binds it to a variable (spacing.2)."
        },
        "padding": {
            "values": {
                "1": "2px 6px",
                "2": "4px 8px",
                "3": "4px 10px"
            },
            "unit": "px",
            "note": "Format: vertical horizontal. In Figma only the vertical padding of size 2 and 3 (spacing.1) and the horizontal padding of size 2 (spacing.2) are bound to variables; the rest are loose values."
        },
        "iconSize": {
            "values": {
                "1": 12,
                "2": 16,
                "3": 16
            },
            "unit": "px",
            "note": "In size 2 and 3 the icon binds width and height to spacing.4."
        },
        "fontSize": {
            "values": {
                "1": 12,
                "2": 12,
                "3": 14
            },
            "unit": "px",
            "note": "Inferred from the text-style.1 and text-style.2 styles (the same ones Link uses); not read here."
        }
    },
    "behavior": {
        "overflow": "nowrap",
        "motion": [],
        "responsive": []
    },
    "content": {
        "label": {
            "maxLength": 24,
            "casing": "sentence",
            "voice": "Status or category in one or two words: \"New\", \"In review\""
        }
    },
