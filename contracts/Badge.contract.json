    "a11y": {
        "role": "None of its own: it is text in a <span>, not a control.",
        "name": "The text (children). If there is an icon, it is decorative: the text already says the same.",
        "keyboard": [],
        "focusIndicator": "Does not receive focus: not interactive. If it needs to be pressable, use Button or Link.",
        "minTarget": "Not applicable: not interactive.",
        "contrastNote": "Text on background ≥ 4.5:1 (WCAG 1.4.3). Not measured in Figma. Look more carefully at soft, surface and outline in light colors (amber, yellow, lime, mint, sky). solid uses white-contrast or black-contrast depending on the color.",
        "wcag": [
            "1.3.1 Info and Relationships",
            "1.4.1 Use of Color",
            "1.4.3 Contrast (Minimum)"
        ]
    },
    "testing": {
        "cases": [
            "does not receive focus or emit events",
            "text is not truncated or wrapped (nowrap)",
            "each variant × color × highContrast uses the tokens in tokens.bindings",
            "highContrast uses step 12 (or 1 on solid) in all variants and colors",
            "solid uses black-contrast on warning, info, sky, mint, lime, yellow and amber; accent-contrast on accent; white-contrast on the rest",
            "the icon is only rendered if icon is passed, and uses the layout.iconSize size according to size",
            "height results in 20 / 24 / 28 px according to size, with and without an icon"
        ]
    },
    "anchors": {
