{
  "$schema": "./component.schema.json",
  "id": "<kebab-case, e.g. button>",
  "name": "<ComponentName>",
  "version": "0.1.0",
  "status": "draft",
  "category": "<action | input | container | overlay | data | media | navigation | feedback>",
  "description": "<One sentence: what this component does for the user.>",
  "guidance": {
    "dos": [
      "<Concrete, verifiable good practice>"
    ],
    "donts": [
      {
        "case": "<Case in which it is NOT used>",
        "useInstead": "<Correct component or pattern>",
        "why": "<Reason in one line>"
      }
    ],
    "related": [
      {
        "component": "<Other component>",
        "relation": "alternative | similar | contains | contained-by",
        "difference": "<How it differs>"
      }
    ]
  },
  "semantics": {
    "element": "<root HTML element: button | div | section | input ...>",
    "role": "<explicit ARIA role, or null if implicit>",
    "refTarget": "<anatomy part that receives the ref>",
    "elementByProp": null
  },
  "props": [
    {
      "name": "<prop>",
      "type": "<'a' | 'b' | boolean | ReactNode | function ...>",
      "default": "<value or null>",
      "required": false,
      "description": "<What it controls and how each value looks.>",
      "usage": "<optional usage example>",
      "bindings": {
        "figma": {
          "property": "<exact property name in Figma>",
          "type": "VARIANT | BOOLEAN | TEXT | INSTANCE_SWAP | SLOT"
        }
      }
    }
  ],
  "states": {
    "native": [
      "hover",
      "focus-visible",
      "active"
    ],
    "controlled": [
      {
        "name": "<prop-controlled state>",
        "description": "<What it means and how it behaves.>",
        "aria": "<aria or native attribute>"
      }
    ]
  },
  "anatomy": {
    "root": {
      "element": "<HTML element>",
      "description": "<Component root.>",
      "figmaLayer": "<nombre exacto de la capa en Figma>"
    },
    "<parte>": {
      "element": "<span | svg | slot | ...>",
      "description": "<What it is.>",
      "optional": true,
      "figmaLayer": "<capa en Figma>",
      "figmaToggle": {
        "property": "<Figma boolean that shows or hides the part and has no prop in code>",
        "type": "BOOLEAN",
        "default": false
      },
      "content": {
        "prop": "<prop that fills the content, e.g. children>"
      },
      "slot": {
        "key": "<slot name>",
        "allowedComponents": [
          "<Accepted component>"
        ],
        "minItems": 0,
        "maxItems": 1,
        "mandatory": false,
        "figmaProp": "<slot or instance swap property in Figma>"
      }
    }
  },
  "composition": {
    "allowedChildren": [
      "<components allowed inside, or null>"
    ],
    "forbiddenChildren": [
      "<components that never go inside>"
    ],
    "nestedComponents": [
      {
        "part": "<part>",
        "component": "<Component>",
        "fixedProps": {}
      }
    ],
    "codeParts": [
      {
        "name": "<Component.Part>",
        "description": "<only if the code API is compound (Root, Trigger, Content...)>"
      }
    ],
    "asChild": false
  },
  "layout": {
    "height": {
      "mode": "fixed | hug | fill",
      "values": {
        "s": 0,
        "m": 0,
        "l": 0
      },
      "unit": "px",
      "token": "<token, supports {size}>"
    },
    "width": {
      "default": "hug | fill | fixed",
      "modes": {
        "hug": "<...>",
        "fill": "<...>",
        "fixed": "<...>"
      },
      "min": null,
      "max": null,
      "note": "<...>"
    },
    "autoLayout": {
      "direction": "HORIZONTAL | VERTICAL",
      "sizingHorizontal": "HUG | FILL | FIXED",
      "sizingVertical": "HUG | FILL | FIXED",
      "alignMain": "MIN | CENTER | MAX | SPACE_BETWEEN",
      "alignCross": "MIN | CENTER | MAX",
      "gap": "<token and between which parts>"
    }
  },
  "tokens": {
    "policy": {
      "allowed": [
        "colors",
        "spacing",
        "radius",
        "text-style",
        "shadows"
      ],
      "forbidden": []
    },
    "bindings": {
      "base": {
        "<propiedad visual>": "<token, supports {prop}, which expands across the enum values>"
      },
      "byVariant": {
        "<valor de variant>": {
          "background": "<token>",
          "text": "<token>",
          "icon": "<token>",
          "border": "<token or null>"
        }
      },
      "byState": {
        "disabled": {
          "background": "<token>",
          "text": "<token>",
          "icon": "<token>",
          "border": "<token>"
        }
      }
    }
  },
  "events": [
    {
      "name": "<onPress | onOpenChange | onValueChange ...>",
      "trigger": "<what triggers it>",
      "payload": "<event type>",
      "blockedWhen": [
        "<state in which it is not emitted>"
      ]
    }
  ],
  "a11y": {
    "role": "<ARIA role or the element's implicit role>",
    "name": "<how it gets its accessible name>",
    "keyboard": [
      "<Key — action>"
    ],
    "focusIndicator": "<token and thickness of the focus indicator>",
    "minTarget": "<minimum touch area, e.g. 24x24px (WCAG 2.5.8)>",
    "contrastNote": "<contrast requirement>",
    "wcag": [
      "<WCAG criterion>"
    ]
  },
  "content": {
    "label": {
      "maxLength": 0,
      "casing": "sentence | title | upper",
      "voice": "<tone and example>"
    }
  },
  "behavior": {
    "loading": null,
    "overflow": "<truncate | wrap | scroll>",
    "motion": [
      {
        "on": "<hover | open | ...>",
        "property": "<property>",
        "reducedMotion": "instant"
      }
    ],
    "responsive": []
  },
  "form": null,
  "overlay": null,
  "data": null,
  "media": null,
  "theming": {
    "modes": [
      "light",
      "dark"
    ],
    "density": null
  },
  "i18n": {
    "rtl": "<behavior in RTL>",
    "textExpansion": "<what happens with text 30-40% longer>"
  },
  "testing": {
    "cases": [
      "<behavior that must be verified>"
    ]
  },
  "governance": {
    "owners": [
      "<team>"
    ],
    "changelog": "<path or link>"
  },
  "anchors": {
    "figma": {
      "file": "<URL of the Figma file>",
      "node": "<component node id>"
    },
    "code": {
      "importPath": "<import path>",
      "export": "<exported name>"
    }
  },
  "meta": {
    "source": "manual | figma | mixed",
    "needsReview": [
      "<fields pending review>"
    ],
    "derivableFromSource": [
      "props.type",
      "props.default",
      "layout"
    ]
  }
}
