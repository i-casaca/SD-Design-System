{
  "$schema": "./component.schema.json",
  "id": "switch",
  "name": "Switch",
  "version": "0.1.0",
  "status": "draft",
  "category": "input",
  "description": "Two-position (on / off) switch whose effect applies as soon as it changes. Alternative to the checkbox for settings.",
  "guidance": {
    "dos": [
      "Use a Switch for settings with immediate effect: \"Notifications\", \"Dark mode\".",
      "Write the label (`label`) in positive terms, describing the \"on\" state: \"Receive alerts\".",
      "Place the label to the right of the switch.",
      "Apply the change instantly, with no save button."
    ],
    "donts": [
      {
        "case": "Option confirmed when submitting a form",
        "useInstead": "Checkbox",
        "why": "A Switch promises immediate effect; a checkbox waits for submission."
      },
      {
        "case": "Choosing one option among several",
        "useInstead": "RadioGroup",
        "why": "A Switch has only two positions."
      },
      {
        "case": "Selecting several items from a list",
        "useInstead": "Checkbox",
        "why": "A Switch does not support an indeterminate state."
      },
      {
        "case": "Triggering an action",
        "useInstead": "Button",
        "why": "A Switch stores a state; it does not execute anything."
      }
    ],
    "related": [
      {
        "component": "Checkbox",
        "relation": "alternative",
        "difference": "Confirmed with the form; supports indeterminate."
      },
      {
        "component": "RadioGroup",
        "relation": "alternative",
        "difference": "One option among several."
      },
      {
        "component": "Button",
        "relation": "alternative",
        "difference": "Executes an action."
      }
    ]
  },
  "semantics": {
    "element": "button",
    "role": "switch",
    "refTarget": "track",
    "elementByProp": null
  },
  "props": [
    {
      "name": "variant",
      "type": "'classic' | 'surface' | 'soft'",
      "default": "surface",
      "description": "Appearance. surface = track with border; classic = same with inner shadow; soft = faint accent fill with no border.",
      "bindings": {
        "figma": {
          "property": "variant",
          "type": "VARIANT"
        }
      }
    },
    {
      "name": "size",
      "type": "'1' | '2' | '3'",
      "default": "2",
      "description": "Track size: 28x16 / 35x20 / 42x24 px, with its thumb and spacing. 2 is the default.",
      "bindings": {
        "figma": {
          "property": "size",
          "type": "VARIANT"
        }
      }
    },
    {
      "name": "highContrast",
      "type": "boolean",
      "default": false,
      "description": "If true and the switch is on, uses accent step 12. Off, it barely changes.",
      "bindings": {
        "figma": {
          "property": "highContrast",
          "type": "VARIANT",
          "value": "true"
        }
      }
    },
    {
      "name": "checked",
      "type": "boolean",
      "default": false,
      "description": "On. In Figma it is the `status` axis: false = \"unchecked ✦\", true = \"checked\".",
      "bindings": {
        "figma": {
          "property": "status",
          "type": "VARIANT",
          "value": "checked"
        }
      }
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": false,
      "description": "If true, it cannot be changed. In Figma it is the \"disable\" value of the `state` axis.",
      "bindings": {
        "figma": {
          "property": "state",
          "type": "VARIANT",
          "value": "disable"
        }
      }
    },
    {
      "name": "label",
      "type": "string | undefined",
      "default": null,
      "description": "Text to the right of the switch. In Figma the `text` boolean shows or hides it (hidden by default). Sample text: \"Text\".",
      "bindings": {
        "figma": {
          "property": "⮑ ✏️ text",
          "type": "TEXT"
        }
      }
    },
    {
      "name": "name",
      "type": "string | undefined",
      "default": null,
      "description": "Field name when submitting a form. Code only.",
      "bindings": {
        "figma": null
      }
    },
    {
      "name": "onCheckedChange",
      "type": "(checked: boolean) => void",
      "default": null,
      "description": "Emitted when the position changes. Code only.",
      "bindings": {
        "figma": null
      }
    }
  ],
  "states": {
    "native": [
      "hover",
      "focus-visible",
      "active"
    ],
    "controlled": [
      {
        "name": "checked",
        "description": "On. The thumb moves to the right and the track uses the accent.",
        "aria": "aria-checked='true'"
      },
      {
        "name": "disabled",
        "description": "Not interactive. Track and thumb use neutral tokens; never opacity.",
        "aria": "disabled (native HTML attribute)"
      }
    ]
  },
  "anatomy": {
    "root": {
      "element": "span",
      "description": "Container for switch and label. A single pressable target.",
      "figmaLayer": "Switch (each variant of the component set)"
    },
    "focusRing": {
      "element": "css",
      "description": "Not an element: painted with :focus-visible. In Figma it is a layer shown with the focusRing boolean: 4px outer and 2px inner border.",
      "optional": true,
      "figmaLayer": "focus-ring",
      "figmaToggle": {
        "property": "focusRing",
        "type": "BOOLEAN",
        "default": false
      }
    },
    "track": {
      "element": "button",
      "description": "The track. Carries role=switch and aria-checked.",
      "figmaLayer": "switch"
    },
    "thumb": {
      "element": "span",
      "description": "The circular thumb. Left when off, right when on.",
      "figmaLayer": "thumb"
    },
    "label": {
      "element": "label",
      "description": "Text to the right. Associated with the switch.",
      "optional": true,
      "figmaLayer": "Text",
      "figmaToggle": {
        "property": "text",
        "type": "BOOLEAN",
        "default": false
      },
      "content": {
        "prop": "label"
      }
    }
  },
