{
  "$schema": "./component.schema.json",
  "id": "button",
  "name": "Button",
  "version": "2.0.0",
  "status": "draft",
  "category": "action",
  "description": "Triggers an action when the user presses it. Emphasis is chosen with `variant`, meaning with `color`, and contrast can be strengthened with `highContrast`.",
  "guidance": {
    "dos": [
      "A single primary action per view: `variant=\"solid\"` (or `classic`) with `color=\"accent\"`.",
      "Label with a verb and an object: \"Save changes\", not \"OK\".",
      "Use `color=\"error\"` only for destructive actions and ask for confirmation if they cannot be undone.",
      "Use `highContrast` when you need more contrast than the accent color gives.",
      "Emphasis hierarchy from highest to lowest: solid/classic → soft/surface → outline → ghost."
    ],
    "donts": [
      {
        "case": "Pure navigation between pages",
        "useInstead": "Link",
        "why": "A link can be opened in a new tab, copied, and screen readers announce it as a link."
      },
      {
        "case": "State that persists (on / off)",
        "useInstead": "Toggle or Checkbox",
        "why": "A button executes; it does not hold state."
      },
      {
        "case": "Icon-only button",
        "useInstead": "IconButton",
        "why": "Requires an accessible name and has its own measurements; the Figma Button always carries a label."
      },
      {
        "case": "Two solid/classic buttons with accent color in the same view",
        "useInstead": "One solid and the rest soft, outline or ghost",
        "why": "If everything stands out, nothing does."
      },
      {
        "case": "Submitting a form without declaring it",
        "useInstead": "Explicit type='submit'",
        "why": "The default is type='button' to avoid accidental submissions."
      }
    ],
    "related": [
      {
        "component": "Link",
        "relation": "similar",
        "difference": "Navigates to another page or resource; the button executes an action."
      },
      {
        "component": "Toggle",
        "relation": "similar",
        "difference": "Keeps a pressed state (aria-pressed)."
      },
      {
        "component": "IconButton",
        "relation": "alternative",
        "difference": "Icon only; requires an accessible name."
      }
    ]
  },
  "semantics": {
    "element": "button",
    "role": null,
    "refTarget": "root",
    "elementByProp": null
  },
  "props": [
    {
      "name": "variant",
      "type": "'classic' | 'solid' | 'soft' | 'surface' | 'outline' | 'ghost'",
      "default": "solid",
      "description": "Visual emphasis. solid = full fill; classic = gradient fill with border; soft = subtle fill; surface = border with soft background; outline = border only; ghost = no fill or border until hover.",
      "bindings": {
        "figma": {
          "property": "variant",
          "type": "VARIANT"
        }
      }
    },
    {
      "name": "color",
      "type": "'accent' | 'neutral' | 'error'",
      "default": "accent",
      "description": "Color meaning. accent = brand color; neutral = gray; error = destructive action.",
      "bindings": {
        "figma": {
          "property": "color",
          "type": "VARIANT"
        }
      }
    },
    {
      "name": "size",
      "type": "'1' | '2' | '3' | '4'",
      "default": "2",
      "description": "Physical size: height 24 / 32 / 40 / 48 px, and with it padding, text, gap and radius. 2 is the default.",
      "bindings": {
        "figma": {
          "property": "size",
          "type": "VARIANT"
        }
      }
    },
    {
      "name": "highContrast",
      "type": "boolean",
      "default": false,
      "description": "If true, strengthens contrast: uses step 12 of the scale instead of 9/11.",
      "bindings": {
        "figma": {
          "property": "highContrast",
          "type": "VARIANT",
          "value": "true"
        }
      }
    },
    {
      "name": "loading",
      "type": "boolean",
      "default": false,
      "description": "If true, the action is in progress: a spinner replaces icon and label, the width does not change and it cannot be pressed.",
      "bindings": {
        "figma": {
          "property": "loading",
          "type": "VARIANT",
          "value": "true"
        }
      }
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": false,
      "description": "If true, the button is not interactive. In Figma it is the \"disable\" value of the `state` axis.",
      "bindings": {
        "figma": {
          "property": "state",
          "type": "VARIANT",
          "value": "disable"
        }
      }
    },
    {
      "name": "icon",
      "type": "ReactNode | undefined",
      "default": null,
      "description": "Leading icon (iconStart in Figma). Size by size: 16 / 16 / 18 / 20 px. aria-hidden because the label already describes the action.",
      "usage": "icon={<Plus />}",
      "bindings": {
        "figma": {
          "property": "⮑ 🔄 iconStart",
          "type": "INSTANCE_SWAP"
        }
      }
    },
    {
      "name": "iconEnd",
      "type": "ReactNode | undefined",
      "default": null,
      "description": "Trailing icon. Same sizes as icon.",
      "usage": "iconEnd={<ArrowRight />}",
      "bindings": {
        "figma": {
          "property": "⮑ 🔄 iconEnd",
          "type": "INSTANCE_SWAP"
        }
      }
    },
    {
      "name": "type",
      "type": "'button' | 'submit' | 'reset'",
      "default": "button",
      "description": "Native button type. Code only. Use 'submit' explicitly to submit forms.",
      "bindings": {
        "figma": null
      }
    },
    {
      "name": "children",
      "type": "ReactNode",
      "required": true,
      "description": "Label content. Default text in Figma: \"Button\".",
      "bindings": {
        "figma": {
          "property": "✏️ text",
          "type": "TEXT"
        }
      }
    },
    {
      "name": "onPress",
      "type": "(event: MouseEvent<HTMLButtonElement>) => void",
      "default": null,
      "description": "Press handler (mouse, keyboard or touch). Code only.",
      "bindings": {
        "figma": null
      }
    }
  ],
  "states": {
    "native": [
      "hover",
      "focus-visible",
      "active"
    ],
    "controlled": [
      {
        "name": "loading",
        "description": "The triggered action is in progress. Not interactive and shows a spinner instead of the content.",
        "aria": "aria-busy='true'"
      },
      {
        "name": "disabled",
        "description": "Not interactive. The option exists but is currently unavailable. Painted with neutral tokens (neutral-alpha), never with opacity.",
        "aria": "disabled (native HTML attribute)"
      }
    ]
  },
  "anatomy": {
    "root": {
      "element": "button",
      "description": "Root interactive element. Always a native <button>.",
      "figmaLayer": "Button (each variant of the Button/<variant> sets)"
    },
    "focusRing": {
      "element": "css",
      "description": "Not an element: painted with :focus-visible. In Figma it is a layer shown with the focusRing boolean: 4px outer border and 2px inner.",
      "optional": true,
      "figmaLayer": "focus-ring",
      "figmaToggle": {
        "property": "focusRing",
        "type": "BOOLEAN",
        "default": false
      }
    },
    "icon": {
      "element": "slot",
      "description": "Slot for the leading icon. Hidden when there is no icon.",
      "optional": true,
      "figmaLayer": "icon",
      "figmaToggle": {
        "property": "iconStart",
        "type": "BOOLEAN",
        "default": false
      },
      "slot": {
        "key": "icon",
        "allowedComponents": [
          "Icon"
        ],
        "minItems": 0,
        "maxItems": 1,
        "mandatory": false,
        "figmaProp": "⮑ 🔄 iconStart"
      }
    },
    "label": {
      "element": "span",
      "description": "Label text.",
      "figmaLayer": "label",
      "content": {
        "prop": "children"
      }
    },
    "iconEnd": {
      "element": "slot",
      "description": "Slot for the trailing icon.",
      "optional": true,
      "figmaLayer": "iconEnd",
      "figmaToggle": {
        "property": "iconEnd",
        "type": "BOOLEAN",
        "default": false
      },
      "slot": {
        "key": "iconEnd",
        "allowedComponents": [
          "Icon"
        ],
        "minItems": 0,
        "maxItems": 1,
        "mandatory": false,
        "figmaProp": "⮑ 🔄 iconEnd"
      }
    },
    "spinner": {
      "element": "svg",
      "description": "8-blade spinner. Only with loading=true; replaces icon and label.",
      "optional": true,
      "figmaLayer": "spinner"
    }
  },
  "composition": {
    "allowedChildren": null,
    "forbiddenChildren": [
      "Button",
      "a",
      "input"
    ],
    "nestedComponents": [],
    "asChild": false
  },
  "layout": {
    "height": {
      "mode": "fixed",
      "values": {
        "1": 24,
        "2": 32,
        "3": 40,
        "4": 48
      },
      "unit": "px",
      "token": "tokens.space.button-height-{size}"
    },
    "width": {
      "default": "hug",
      "modes": {
        "hug": "Width fits the content plus horizontal padding. Default.",
        "fill": "Decided by the consumer through their layout; there is no prop.",
        "fixed": "Explicit value from the consumer of the component. No system token."
      },
      "min": null,
      "max": null,
      "note": "In Figma, loading=true keeps the width (verified in size 2: 70px with and without loading)."
    },
    "autoLayout": {
      "direction": "HORIZONTAL",
      "sizingHorizontal": "HUG",
      "sizingVertical": "FIXED",
      "alignMain": "CENTER",
      "alignCross": "CENTER",
      "gap": "Per size: spacing.1 / 2 / 3 / 3, between icon and label"
    },
    "iconSize": {
      "values": {
        "1": 16,
        "2": 16,
        "3": 18,
        "4": 20
      },
      "unit": "px"
    }
  },
  "tokens": {
    "policy": {
      "allowed": [
        "colors",
        "tokens.colors",
        "tokens.space",
        "spacing",
        "radius",
        "text-style",
        "shadows",
        "overlays"
      ],
      "forbidden": []
    },
    "scales": {
      "accent": {
        "step": "colors.accent.accent",
        "alpha": "colors.accent.accent-alpha",
        "surface": "tokens.colors.accent-surface",
        "onSolid": "tokens.colors.accent-contrast",
        "onSolidHigh": "colors.neutral.neutral.1",
        "fg": "colors.accent.accent-alpha.11",
        "fgHigh": "colors.accent.accent.12",
        "strokeHigh": "colors.neutral.neutral-alpha.11",
        "hcShadow": "accent"
      },
      "neutral": {
        "step": "colors.neutral.neutral",
        "alpha": "colors.neutral.neutral-alpha",
        "surface": null,
        "onSolid": "tokens.colors.white-contrast",
        "onSolidHigh": "colors.neutral.neutral.1",
        "fg": "colors.neutral.neutral.11",
        "fgHigh": "colors.neutral.neutral.12",
        "strokeHigh": "colors.neutral.neutral-alpha.11",
        "hcShadow": "neutral"
      },
      "error": {
        "step": "colors.semantic.error",
        "alpha": "colors.semantic.error-alpha",
        "surface": null,
        "onSolid": "tokens.colors.white-contrast",
        "onSolidHigh": "colors.semantic.error.1",
        "fg": "colors.semantic.error.11",
        "fgHigh": "colors.semantic.error.12",
        "strokeHigh": "colors.semantic.error.11",
        "hcShadow": "accent"
      }
    },
    "bindings": {
      "base": {
        "textStyle": "text-style.{size}.medium",
        "focusRingOuter": {
          "color": "colors.accent.accent-alpha.8",
          "width": 4
        },
        "focusRingInner": {
          "color": "colors.accent.accent.3",
          "width": 2
        }
      },
      "bySize": {
        "1": {
          "height": "tokens.space.button-height-1",
          "paddingX": "spacing.2",
          "gap": "spacing.1",
          "radius": "radius.1-max"
        },
        "2": {
          "height": "tokens.space.button-height-2",
          "paddingX": "spacing.3",
          "gap": "spacing.2",
          "radius": "radius.2-max"
        },
        "3": {
